# ABOUTME: Example environment variables for intervals-icu-mcp
# ABOUTME: Copy to .env (or configure in your MCP client's env block) and fill in

# Required. Get from intervals.icu Settings -> Developer Settings.
INTERVALS_API_KEY=

# Optional. Leave unset for normal use (resolves to your athlete via the key).
# Set to an explicit athlete id only for coach accounts.
# INTERVALS_ATHLETE_ID=0

# Optional. Override only for staging or when behind a proxy.
# INTERVALS_BASE_URL=https://intervals.icu/api/v1
